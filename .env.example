# Copy to .env and fill in. .env is gitignored.

# Supabase project settings, API section. The URL is the project origin with no path:
# supabase-js appends /rest/v1 and /auth/v1 itself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=
# Server-side only. Bypasses row level security, so it never sits on a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_SECRET_KEY=

# Resend, for the approval email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. A URL holding the Aeonik bundle that scripts/fonts.mjs writes into public/fonts/.
# Produce the value with: node scripts/fonts.mjs pack
AEONIK_FONTS_URL=
