# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project settings, API section
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row level security, so it never reaches the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, for the approval email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. A URL holding the Aeonik bundle that scripts/fonts.mjs writes into public/fonts/.
# Produce the value with: node scripts/fonts.mjs pack
AEONIK_FONTS_URL=
